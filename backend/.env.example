# Copia este archivo a .env y ajusta los valores para tu entorno local.
# .env no debe subirse al repositorio (agrégalo a .gitignore).

# Cadena de conexión a PostgreSQL: postgresql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/renta_db

# Clave secreta para firmar los tokens JWT — genera una propia, no uses esta.
# Por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esta-clave-por-una-generada-tuya

# Minutos de validez del token (opcional, por defecto 60)
JWT_EXPIRACION_MINUTOS=60

# Orígenes del frontend autorizados por CORS, separados por coma (opcional)
ORIGENES_PERMITIDOS=http://localhost:5173,http://127.0.0.1:5173

# Tamaño máximo del archivo de exógena en MB (opcional, por defecto 5)
TAMANO_MAXIMO_EXOGENA_MB=5
